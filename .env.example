# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
XAI_API_KEY=your_xai_api_key_here

# Data Source API Keys
TUSHARE_TOKEN=your_tushare_token_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Optional: OpenRouter（当前 LLM 提供方）
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=
DEFAULT_CHAT_MODEL=
DEFAULT_QUICK_MODEL=minimax/minimax-m2.5

# Redis / 分析状态持久化（Docker prod 默认 redis，本地 dev 默认 memory）
REDIS_HOST=localhost
REDIS_PORT=6379
ANALYSIS_STORAGE=memory
ANALYSIS_STATE_TTL_DAYS=7

# 舆情数据源 Cookie (可选，用于获取雪球和东方财富股吧数据)
# 访问 https://xueqiu.com 和 https://guba.eastmoney.com 登录后，从浏览器开发者工具复制 Cookie
XUEQIU_COOKIE=your_xueqiu_cookie_here
GUBA_COOKIE=your_guba_cookie_here

# Application Settings
SPRING_PROFILES_ACTIVE=dev
TRADINGAGENTS_LOCALE=zh
TRADINGAGENTS_RESULTS_DIR=./results
